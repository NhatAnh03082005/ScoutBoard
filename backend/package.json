{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:generate": "npm run typeorm -- migration:generate -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/run-seeds.ts",
    "sync:match-stats": "ts-node -r tsconfig-paths/register src/scripts/sync-remaining-fixture-stats.ts",
    "enrich:profiles": "ts-node -r tsconfig-paths/register src/scripts/enrich-remaining-profiles.ts",
    "sync:41-matches": "ts-node -r tsconfig-paths/register src/scripts/sync-41-laliga-matches.ts",
    "enrich:laliga": "ts-node -r tsconfig-paths/register src/scripts/enrich-laliga-profiles.ts",
    "sync:laliga-positions": "ts-node -r tsconfig-paths/register src/scripts/sync-laliga-positions.ts",
    "sync:laliga-remaining-matches": "ts-node -r tsconfig-paths/register src/scripts/sync-laliga-remaining-matches.ts",
    "sync:top5-leagues": "ts-node -r tsconfig-paths/register src/scripts/sync-top5-leagues.ts",
    "sync:transfers": "ts-node -r tsconfig-paths/register src/scripts/sync-club-transfers.ts",
    "sync:top-stars": "ts-node -r tsconfig-paths/register src/scripts/sync-top-stars-transfers.ts",
    "enrich:top3-profiles": "ts-node -r tsconfig-paths/register src/scripts/enrich-top3-leagues-profiles.ts",
    "enrich:all-profiles": "ts-node -r tsconfig-paths/register src/scripts/enrich-all-remaining-profiles.ts",
    "sync:top3-positions": "ts-node -r tsconfig-paths/register src/scripts/sync-top3-leagues-positions.ts",
    "sync:missing-bundesliga": "ts-node -r tsconfig-paths/register src/scripts/sync-missing-bundesliga-clubs.ts",
    "sync:85-transfers": "ts-node -r tsconfig-paths/register src/scripts/sync-85-career-transfers.ts",
    "sync:next-transfers": "ts-node -r tsconfig-paths/register src/scripts/sync-next-batch-transfers.ts"
  },
  "dependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.6.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "helmet": "^8.3.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
