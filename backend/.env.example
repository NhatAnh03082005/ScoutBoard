# ============================================================
# ScoutBoard Backend — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----- PostgreSQL -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=scoutboard_db

DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/scoutboard_db?schema=public

# ----- Application -----
NODE_ENV=development
PORT=3000

# ----- JWT -----
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ----- API-Football (Single External Football Data Provider) -----
# Source: https://dashboard.api-football.com/
API_FOOTBALL_KEY=your_api_football_key
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_TIMEOUT=20000
API_FOOTBALL_PROVIDER=API_FOOTBALL

