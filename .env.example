# Database PostgreSQL Configuration
POSTGRES_DB=scoutboard_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5432

# pgAdmin UI Configuration
PGADMIN_EMAIL=admin@scoutboard.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=8080

# Database Connection String for NestJS Backend
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/scoutboard_db?schema=public

# Optional Supabase Storage for account avatars.
# Without these values, development uses local files and production uses PostgreSQL.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_AVATAR_BUCKET=avatars
BACKEND_PUBLIC_URL=http://localhost:3000
